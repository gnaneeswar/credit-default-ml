# syntax=docker/dockerfile:1.7
# Training image: ingest -> EDA -> tune 4 models (3-fold CV) -> OOF threshold ->
# register models:/credit-default-pipeline@champion -> holdout eval -> Evidently monitoring.
# Self-contained: the cached UCI dataset is baked in, so it runs fully offline.
FROM --platform=linux/amd64 python:3.12-slim-bookworm

# Pinned uv, same version used to produce uv.lock locally.
COPY --from=ghcr.io/astral-sh/uv:0.13.10 /uv /uvx /bin/

# libgomp1: OpenMP runtime required by LightGBM (XGBoost bundles its own).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=python3.12 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Shared with Dockerfile.serve: WORKDIR + relative MLflow URIs make artifact paths
# (file:///app/mlruns/...) resolve identically in both containers.
WORKDIR /app

# Dependency layer: cached until pyproject.toml / uv.lock change. --frozen = exact lock.
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY src/ ./src/
COPY data/ ./data/
RUN python -m compileall -q src \
    && mkdir -p /app/mlruns /app/artifacts \
    && chmod 1777 /app/mlruns /app/artifacts

# Runtime: call the venv directly (no `uv run` re-sync at start-up). HOME/MPLCONFIGDIR are
# writable for any UID; USER/LOGNAME let getpass.getuser() (used by MLflow) work for a
# UID with no /etc/passwd entry, e.g. `docker run -u $(id -u):$(id -g)`.
ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib \
    USER=mlops \
    LOGNAME=mlops \
    OMP_NUM_THREADS=1

USER 1000:1000
CMD ["python", "-m", "src.training.run"]
